# Frontend-safe
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy name supported temporarily for existing setups.
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=
# Google Analytics 4 measurement id (leave blank to disable analytics)
VITE_GA_MEASUREMENT_ID=

# Server-only Supabase Edge Function secrets (set in Supabase dashboard, NOT here)
SUPABASE_SERVICE_ROLE_KEY=
OTP_PEPPER=
DEVELOPMENT_OTP_MODE=false

# Email provider — pick ONE:
#   A) Brevo (recommended for free tier without a domain — 300 emails/day, any recipient)
BREVO_API_KEY=
#   B) Resend (3000 emails/mo free; needs verified domain to send to ANY email)
RESEND_API_KEY=
# Sender identity. For Brevo, EMAIL_FROM must be a verified single sender email.
# Format: "Name <email>" or plain "email"
EMAIL_FROM="Vishal Mens Parlour <bookings@yourdomain.com>"
OWNER_NOTIFICATION_EMAIL=

# Manage-booking signed link secret + public site URL used in emails
MANAGE_LINK_SECRET=
PUBLIC_SITE_URL=

# (Legacy) SMS provider settings — no longer used, verification is email-based.
# Kept here only for future re-enablement.
# SMS_PROVIDER=
# MSG91_TEMPLATE_ID=
# MSG91_AUTH_KEY=
